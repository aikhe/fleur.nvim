      "dark": "lis",
      "light": "anemone"
    },
    "markdownListEnumeration": {
      "dark": "bleuet",
      "light": "bleuet"
    },
    "markdownImage": {
      "dark": "bleuet",
      "light": "bleuet"
    },
    "markdownImageText": {
      "dark": "gray6_dark",
      "light": "gray6_light"
    },
    "markdownCodeBlock": {
      "dark": "gray8_dark",
      "light": "gray8_light"
    },
    "syntaxComment": {
      "dark": "gray4_dark",
      "light": "gray4_light"
    },
    "syntaxKeyword": {
      "dark": "gray5_dark",
      "light": "gray5_light"
    },
    "syntaxFunction": {
      "dark": "lis",
      "light": "anemone"
    },
    "syntaxVariable": {
      "dark": "gray8_dark",
      "light": "gray8_light"
    },
    "syntaxString": {
      "dark": "bleuet",
      "light": "bleuet"
    },
    "syntaxNumber": {
      "dark": "gray6_dark",
      "light": "gray6_light"
    },
    "syntaxType": {
      "dark": "gray6_dark",
      "light": "gray6_light"
    },
    "syntaxOperator": {
      "dark": "gray5_dark",
      "light": "gray5_light"
    },
    "syntaxPunctuation": {
      "dark": "gray5_dark",
      "light": "gray5_light"
    }
