    "markdownCode": {
      "dark": "bruyere",
      "light": "bruyere"
    },
    "markdownBlockQuote": {
      "dark": "gray6_dark",
      "light": "gray6_light"
    },
    "markdownEmph": {
      "dark": "gray7_dark",
      "light": "gray7_light"
    },
