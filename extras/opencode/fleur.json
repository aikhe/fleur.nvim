{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "coquelicot": "#FF8080",
    "zinnia": "#FFBA9D",
    "bruyere": "#8ABE8A",
    "anemone": "#485571",
    "bleuet": "#6D89A7",
    "lis": "#C9D9D8",
    "lulumi": "#A8DFDC",
    "maomi": "#323333",
    "black_dark": "#101010",
    "gray1_dark": "#141414",
    "gray2_dark": "#181818",
    "gray3_dark": "#2A2A2A",
    "gray4_dark": "#3D3D3D",
    "gray5_dark": "#525252",
    "gray6_dark": "#676767",
    "gray7_dark": "#939393",
    "gray8_dark": "#B7B7B7",
    "gray9_dark": "#EDEDED",
    "black_light": "#FFFFFF",
    "gray1_light": "#EDEDED",
    "gray2_light": "#B7B7B7",
    "gray3_light": "#939393",
    "gray4_light": "#676767",
    "gray5_light": "#525252",
    "gray6_light": "#3D3D3D",
    "gray7_light": "#2A2A2A",
    "gray8_light": "#181818",
    "gray9_light": "#141414"
