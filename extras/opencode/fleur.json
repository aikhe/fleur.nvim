      "dark": "lis",
      "light": "anemone"
    },
    "secondary": {
      "dark": "bleuet",
      "light": "bleuet"
    },
    "accent": {
      "dark": "lulumi",
      "light": "anemone"
    },
    "error": {
      "dark": "coquelicot",
      "light": "coquelicot"
    },
    "warning": {
      "dark": "zinnia",
      "light": "zinnia"
    },
    "success": {
      "dark": "bruyere",
      "light": "bruyere"
    },
    "info": {
      "dark": "bleuet",
      "light": "bleuet"
    },
    "text": {
      "dark": "gray8_dark",
      "light": "gray8_light"
    },
    "textMuted": {
      "dark": "gray6_dark",
      "light": "gray4_light"
    },
    "selectedListItemText": {
